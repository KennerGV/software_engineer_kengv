---
import '../styles/components/badges.css';

interface CredlyBadge { nombre: string; id: string; }
interface MicrosoftBadge { nombre: string; imageUrl: string; credentialUrl: string; }

const { cv } = Astro.props;
const credlyBadges: CredlyBadge[] = cv.badges?.credly || [];
const microsoftBadges: MicrosoftBadge[] = cv.badges?.microsoft || [];
const seccionTitulo = cv.ui?.badges || 'Badges';
---
<div class="badge-section" id="badges-section">
  <h2>{seccionTitulo}</h2>
  <div class="badges-grid">
    {microsoftBadges.map((badge) => (
      <a
        href={badge.credentialUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="badge-item microsoft-container"
        title={`Ver certificación oficial: ${badge.nombre}`}>
        <img src={badge.imageUrl} alt={badge.nombre} class="microsoft-badge-img" />
      </a>
    ))}

    {credlyBadges.map((badge) => (
      <div
        class="badge-item"
        data-iframe-width="150"
        data-iframe-height="270"
        data-share-badge-id={badge.id}
        data-share-badge-host="https://www.credly.com"
        title={badge.nombre}
      ></div>
    ))}
  </div>
</div>

<script is:inline type="text/javascript" src="https://cdn.credly.com/assets/utilities/embed.js"></script>