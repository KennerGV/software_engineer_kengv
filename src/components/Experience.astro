---
import '../styles/components/experience.css';

interface Props {
  cv: {
    experiencia: Array<{
      puesto: string;
      empresa: string;
      periodo: string;
      proyectos: Array<{
        cliente: string;
        periodo: string;
        detalles: string[];
      }>;
    }>;
    ui?: { experiencia?: string };
  };
}
const { cv } = Astro.props;
const { experiencia = [] } = cv;
const seccionTitulo = cv.ui?.experiencia || 'Professional Experience';
---

<section class="experience-section">
  <h2>{seccionTitulo}</h2>
  {experiencia.map((job) => (
    <div class="job-card">
      <div class="header">
        <h3>{job.puesto}</h3>
        <span>{job.periodo}</span>
      </div>
      <p class="company">{job.empresa}</p>
      <ul>
        {job.proyectos.map((proyecto) => (
          <>
            <h4 class="cliente">{proyecto.cliente} {proyecto.periodo}</h4>
            <ul>{proyecto.detalles.map(item => <li>{item}</li>)}</ul>
          </>
        ))}
      </ul>
    </div>
  ))}
</section>