---
import '../styles/components/experience.css';

interface Props {
  cv: {
    sobreMi: string;
    ui?: { sobreMi?: string };
  };
}
const { cv } = Astro.props;
const { sobreMi } = cv;
const seccionTitulo = cv.ui?.sobreMi || 'About Me';
---
<section class="experience-section">
  <h2>{seccionTitulo}</h2>
    <div class="job-card">
      <div class="header">
        <span>{sobreMi}</span>
      </div>
    </div>
</section>