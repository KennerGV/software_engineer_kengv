---
import '../styles/components/hero.css';

interface Props {
  cv: {
    sobreMi: string;
  };
}
const { cv } = Astro.props;
const { sobreMi } = cv;
const { currentLocale } = Astro;
const seccionTitulo = currentLocale === 'es' ? 'Sobre Mí' : 'About Me';
---
<section class="experience-section">
  <h2>{seccionTitulo}</h2>
    <div class="job-card">
      <div class="header">
        <span>{sobreMi}</span>
      </div>
    </div>
</section>