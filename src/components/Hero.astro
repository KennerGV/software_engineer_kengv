---
import '../styles/components/experience.css';

interface Props {
  cv: {
    sobreMi: string;
    ui?: { sobreMi?: string };
  };
}
const { cv } = Astro.props;
const { sobreMi } = cv;
const seccionTitulo = cv.ui?.sobreMi || 'About Me';
---
<section class="experience-section about-section">
  <h2>{seccionTitulo}</h2>
  <div class="about-card">
    <p>{sobreMi}</p>
  </div>
</section>