---
import '../styles/components/floating-actions.css';

const { currentLocale } = Astro;

const whatsappUrl = "https://wa.me/50687355106";
const baseUrl = "/software_engineer_kengv";

// Calculamos la URL alterna para el idioma de forma segura
const targetUrl = currentLocale === "es" ? `${baseUrl}/` : `${baseUrl}/es/`;

// Textos e internacionalización dinámicos
const langText = currentLocale === "es" ? "EN" : "ES";
const langTitle =
  currentLocale === "es" ? "Switch to English" : "Cambiar a Español";
const pdfTitle =
  currentLocale === "es" ? "Generar PDF del CV" : "Generate CV PDF";

const seccionMensajeInicial =
  currentLocale === "es"
    ? "¡Hola! Soy el asistente IA de Kener. ¿Qué te gustaría saber sobre mi experiencia en .NET y C#?"
    : "Hello! I am Kener's AI assistant. What would you like to know about my experience in .NET and C?";

const tituloSeccionMensajeInicial =
  currentLocale === "es" ? "Asistente IA de Kener" : "KenerAI Assistant";
const tituloEnline = currentLocale === "es" ? "En línea" : "Online";
const gemeloDigital = currentLocale === "es" ? "Gemelo Digital" : "Digital Twin";
const textLabel = currentLocale === "es" ? "Escribe tu mensaje..." : "Type your message...";
---

<div class="interactive-portfolio-widget">
  <div class="chat-container hidden" id="chat-window">
    <div class="chat-header">
      <div class="header-info">
        <span class="status-dot"></span>
        <div>
          <h4>{tituloSeccionMensajeInicial}</h4>
          <p>{tituloEnline} • {gemeloDigital}</p>
        </div>
      </div>
      <button class="close-chat-btn" id="close-chat-btn" title="Cerrar Chat" type="button">
        &times;
      </button>
    </div>

    <div class="chat-messages" id="chat-messages">
      <div class="message message--assistant">
        <div class="message-content message-content--assistant">
          {seccionMensajeInicial}
        </div>
      </div>
    </div>

    <form id="chat-form" class="chat-form">
      <input
        type="text"
        id="chat-input"
        placeholder={textLabel}
        required
        autocomplete="off"
      />
      <button type="submit" aria-label="Enviar mensaje">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="22" y1="2" x2="11" y2="13"></line><polygon
            points="22 2 15 22 11 13 2 9 22 2"></polygon></svg
        >
      </button>
    </form>
  </div>

  <div class="floating-triggers">
    <div class="action-menu-container">
      <div class="submenu-buttons" id="submenu-links">
        <a href={targetUrl} class="sub-btn idioma" title={langTitle}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path
              d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            ></path>
          </svg>
          <span>{langText}</span>
        </a>

        <button
          id="print-cv-btn"
          class="sub-btn pdf"
          title={pdfTitle}
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>PDF</span>
        </button>

        <a
          href={whatsappUrl}
          target="_blank"
          class="sub-btn whatsapp"
          title="WhatsApp"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 1 1-7.6-10.6 8.38 8.38 0 0 1 3.8.9L21 3z"
            ></path>
          </svg>
          <span>WhatsApp</span>
        </a>
      </div>

      <button class="main-fab" id="toggle-menu" title="Más opciones">
        <span class="plus-icon">+</span>
      </button>
    </div>

    <button class="chat-fab" id="toggle-chat" title="Abrir Chat con IA">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
        ></path></svg
      >
    </button>
  </div>
</div>

<script src="../scripts/floating-actions.js"></script>
