---
import '../styles/components/floating-actions.css';
import '../styles/components/chat.css';
import '../styles/components/buttongoogle.css';
import ChatUI from './ui/ChatUI.astro';

const { currentLocale } = Astro;
const { ui = {} } = Astro.props;
const floating = ui.floating || {};

const openChatTitle = floating.openChat || (currentLocale === "es" ? "Pregúntale a KenerAI" : "Ask KenerAI");
const chatPillText = floating.chatPill || openChatTitle;
---

<div class="interactive-portfolio-widget">
  <ChatUI ui={ui.chat}>
    <svg slot="send-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
  </ChatUI>

  <div class="floating-triggers">
    <button class="chat-fab" id="toggle-chat" title={openChatTitle} aria-label={openChatTitle}>
      <span class="chat-fab-online-dot" aria-hidden="true"></span>
      <img src="/favicon.svg" alt="KG" class="chat-fab-logo" width="22" height="22" />
      <span class="chat-fab-label">{chatPillText}</span>
    </button>
  </div>
</div>

<script src="../scripts/floating-actions.js"></script>
