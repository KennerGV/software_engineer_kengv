---
import Sidebar from '../components/SideBar.astro';
import '../styles/global.css';
import '../styles/layout.css';
import FloatingActions from '../components/FloatingActions.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

const { title = 'Kener Gutiérrez | Software Engineer' } = Astro.props;
const { cvData } = Astro.props;
const { currentLocale } = Astro;
---

<!DOCTYPE html>
<html lang={currentLocale}>
  <head>
    <meta charset="utf-8" />
    <title>{title} - {cvData.nombre}</title>
    <GoogleAnalytics />
  </head>
  <body>
    <div class="app-container">
      <Sidebar cv={cvData} />
      <header class="main-header">
        <h1>{cvData.nombre}</h1>
        <p>{cvData.puesto} | {cvData.ubicacion}</p>
      </header>
      <main>
        <slot />
        <FloatingActions />
      </main>
    </div>
  </body>
</html>